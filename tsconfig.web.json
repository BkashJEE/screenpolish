{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": { "@shared/*": ["./src/shared/*"], "@webm/*": ["./src/webm/*"], "@render/*": ["./src/render/*"] }
  },
  "include": ["src/editor/**/*", "src/capture/**/*", "src/overlay/**/*", "src/render/**/*", "src/shared/**/*", "src/brand/**/*", "src/webm/**/*"]
}
